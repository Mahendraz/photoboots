// Worker `photobooth`: hanya melayani /api/* (kuota strip, titipan ruang foto bareng) dan /auth/* (login Auth0, skema asset.inwebsite.online).
// Semua halaman & aset dilayani langsung sebagai berkas statis (gratis, tidak dihitung request Worker).
// Secret Worker (wrangler secret put): AUTH0_CLIENT_SECRET, SESSION_SECRET. Setelan aplikasi Auth0 ada di README.
{
  "name": "photobooth",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "photobooth.inwebsite.online", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "vars": {
    // Tenant Auth0 bersama aplikasi InWebsite lain; keduanya publik.
    "AUTH0_DOMAIN": "nehard.us.auth0.com",
    // Aplikasi Auth0 "photobooth" (Regular Web Application, dibuat 13 Okt 2026). Client secret ada di secret Worker.
    "AUTH0_CLIENT_ID": "N4zAoqayeSQ7rNKFGtR5Z24U76vuPdwT",
    // Login email + kata sandi (koneksi Username-Password-Authentication), sama seperti asset.inwebsite.online.
    "EMAIL_LOGIN": "true",
    "DAILY_LIMIT": "5"
  },
  // Batas percobaan login email per IP. namespace_id unik per akun Cloudflare (1001–1003, 4401 sudah dipakai proyek lain).
  // ROOM_LIMITER: tulis titipan ruang foto bareng (detak tiap menit + tiap perubahan), per IP.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "5101", "simple": { "limit": 10, "period": 60 } },
    { "name": "ROOM_LIMITER", "namespace_id": "5102", "simple": { "limit": 60, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "photobooth-db",
      "database_id": "a3bc346a-6f6f-4794-8086-9d006d19e0ff",
      "migrations_dir": "migrations"
    }
  ],
  // Hapus estafet (berlaku 4 jam) dan titipan ruang yang kedaluwarsa.
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false }
}
